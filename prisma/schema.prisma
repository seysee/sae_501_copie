generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Players {
  id        Int       @id @default(autoincrement())
  sessionId Int?
  name      String?   @db.VarChar(50)
  role      Int?
  score     Int?
  gameData  String?   @db.Text
  Session   Sessions? @relation(fields: [sessionId], references: [id], onUpdate: Restrict, map: "Players_ibfk_1")

  @@index([sessionId], map: "Players_ibfk_1")
}

model Sessions {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(10)
  playersNumber Int?
  createdAt     DateTime? @default(now()) @db.DateTime(0)
  status        Int?
  questions     Json?     @db.Json
  hostId        Int?
  hints         String?   @default("[]") @db.LongText
  killerId      Int?
  Players       Players[]
  Killer        Suspects? @relation("SessionKiller", fields: [killerId], references: [id], onDelete: Restrict, map: "fk_killerId")

  @@index([killerId], map: "idx_killerId")
}

model Suspects {
  id          Int        @id @default(autoincrement())
  name        String?    @db.VarChar(25)
  description String?    @db.Text
  KilledIn    Sessions[] @relation("SessionKiller")
}

model Suspect_hints {
  id        Int    @id @default(autoincrement())
  suspectId Int
  hintText  String @db.Text

  @@index([suspectId], map: "Suspect_hints_ibfk_1")
}

model Questions {
  id         Int     @id @default(autoincrement())
  type       String  @db.VarChar(50) // Type d'énigme : code, action, puzzle, etc.
  question   String  @db.Text // Texte de l'énigme
  solution   String  @db.Text // Solution attendue
  hint       String? @db.Text // Indice optionnel
  feedback   Json?   @db.Json // Feedback personnalisé pour les réponses correctes ou incorrectes
  difficulty String? @db.VarChar(10) // Niveau de difficulté : facile, moyen, difficile
  assets     String? @db.Text // Chemin vers les ressources associées (images, vidéos, etc.)
  extraData  Json?   @db.Json // Données supplémentaires pour des énigmes complexes sous forme de fichier .js
}
